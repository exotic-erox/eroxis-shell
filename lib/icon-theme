"""icon-theme ICONS_DIR BASE ACCENT NAME : an icon theme NAME that inherits BASE (e.g. Papirus-Dark) with the folder icons recoloured to ACCENT."""
import colorsys, os, re, sys

def hex_of(rgb): return "#%02x%02x%02x" % tuple(round(max(0, min(1, v)) * 255) for v in rgb)

def folder_map(accent):
    h = accent.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    hh, l, s = colorsys.rgb_to_hls(r, g, b)
    return {"5294e2": accent, "4877b1": hex_of(colorsys.hls_to_rgb(hh, l * 0.8, s))}

def recolour(svg, mapping):
    return re.sub(r"#([0-9a-fA-F]{6})(?![0-9a-zA-Z_])", lambda m: mapping.get(m.group(1).lower(), m.group(0)), svg)

def sections(index):
    out, cur = {}, None
    for line in open(index, errors="replace").read().splitlines():
        if line.startswith("[") and line.endswith("]"):
            cur = line[1:-1]; out[cur] = []
        elif cur is not None:
            out[cur].append(line)
    out.pop("Icon Theme", None)
    return out

def main():
    if len(sys.argv) != 5: sys.exit(__doc__)
    icons, base, accent, name = sys.argv[1:]
    src = next((p for p in (os.path.join(icons, base), "/usr/share/icons/" + base, os.path.expanduser("~/.local/share/icons/" + base)) if os.path.isfile(os.path.join(p, "index.theme"))), None)
    if not src: sys.exit("icon theme %s not found" % base)
    mapping, dest, dirs = folder_map(accent), os.path.join(icons, name), {}
    for sect, lines in sections(os.path.join(src, "index.theme")).items():
        if not sect.endswith("/places"): continue
        folder = os.path.join(src, sect)
        if not os.path.isdir(folder): continue
        for f in os.listdir(folder):
            if not f.startswith("folder") or not f.endswith(".svg"): continue
            svg = open(os.path.join(folder, f), errors="replace").read()
            new = recolour(svg, mapping)
            if new == svg: continue
            os.makedirs(os.path.join(dest, sect), exist_ok=True)
            open(os.path.join(dest, sect, f), "w").write(new)
            dirs[sect] = lines
    os.makedirs(dest, exist_ok=True)
    body = "[Icon Theme]\nName=%s\nComment=%s folders in %s\nInherits=%s,Adwaita,hicolor\nDirectories=%s\n" % (name, base, accent, base, ",".join(dirs))
    for sect, lines in dirs.items(): body += "\n[%s]\n%s\n" % (sect, "\n".join(l for l in lines if l.strip()))
    open(os.path.join(dest, "index.theme"), "w").write(body)
    os.system("gtk-update-icon-cache -qf '%s' 2>/dev/null" % dest)

if __name__ == "__main__":
    main()
